# Password for logging into the dashboard. Required unless HOST is 127.0.0.1.
DASHBOARD_PASSWORD=change-me

# Where the dashboard listens. Use 0.0.0.0 to reach it from other machines.
HOST=127.0.0.1
PORT=3000

# How cBots are run:
#   auto        - use Docker if it is available, otherwise simulation
#   docker      - always use the official cTrader CLI Docker image
#   simulation  - never trade; fake bots that print log lines (for trying the dashboard)
RUNNER=auto

# Folder where accounts, uploaded cBots and password files are stored.
DATA_DIR=./data

# Only needed when the dashboard itself runs inside Docker: the same folder as
# DATA_DIR, but as seen from the host machine (see docker-compose.yml).
# HOST_DATA_DIR=/opt/ctrader-dashboard/data

# cTrader CLI image to run cBots with.
CTRADER_IMAGE=ghcr.io/spotware/ctrader-console:latest
